<!--components/wish-edit-modal/index.wxml-->
<wxs src="./fmt.wxs" module="fmt" />
<view class="modal-mask" wx:if="{{visible}}" bindtap="onClose">
  <view class="modal-content glass-card" catchtap="preventBubble">

    <view class="modal-title">✨ 记录这一刻</view>

    <!-- 愿望标题 -->
    <view class="form-group">
      <text class="form-label">一起做点什么~</text>
      <textarea class="form-textarea title-textarea" placeholder="一起做点什么~" value="{{title}}" bindinput="onTitleInput" maxlength="50" catchtap="preventBubble" auto-height />
    </view>

    <!-- 期待 -->
    <view class="form-group">
      <text class="form-label">期待 *</text>
      <picker mode="date" value="{{date}}" bindchange="onDateInput">
        <view class="form-input date-picker">{{date || '请选择日期'}}</view>
      </picker>
    </view>

    <!-- 达成 -->
    <view class="form-group">
      <text class="form-label">达成</text>
      <picker mode="date" value="{{completedDate}}" bindchange="onCompletedDateInput">
        <view class="form-input date-picker">{{completedDate || (isAdd ? '今天' : '请选择日期')}}</view>
      </picker>
    </view>

    <!-- 记录 -->
    <view class="form-group">
      <text class="form-label">记录</text>
      <textarea class="form-textarea feeling-textarea" placeholder="记录这一刻" value="{{feeling}}" bindinput="onFeelingInput" maxlength="500" catchtap="preventBubble" auto-height />
    </view>

    <!-- 图片管理 -->
    <view class="form-group">
      <view class="image-grid">
        <view class="image-item" wx:for="{{images}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill" class="preview-img" catchtap="onPreviewImage" data-url="{{item}}" data-urls="{{images}}"></image>
          <view class="image-remove" catchtap="onRemoveImage" data-index="{{index}}">×</view>
        </view>
        <view class="image-add" wx:if="{{images.length < 9}}" bindtap="onChooseImage">
          <text class="add-icon">+</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="modal-actions">
      <view class="action-btn action-cancel" bindtap="onClose">取消</view>
      <view class="action-btn action-save" bindtap="onSubmit">{{submitting ? '保存中...' : '保存'}}</view>
    </view>

  </view>
</view>
